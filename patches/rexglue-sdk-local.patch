diff --git a/src/kernel/xboxkrnl/xboxkrnl_ob.cpp b/src/kernel/xboxkrnl/xboxkrnl_ob.cpp
index 5709e6d0..0e2777b0 100644
--- a/src/kernel/xboxkrnl/xboxkrnl_ob.cpp
+++ b/src/kernel/xboxkrnl/xboxkrnl_ob.cpp
@@ -154,6 +154,22 @@ u32 ObReferenceObjectByName_entry(mapped_string name, u32 attributes, u32 object
   return result;
 }
 
+u32 ObReferenceObject_entry(u32 native_ptr) {
+  // Mirror ObDereferenceObject: retain the matching native object when there is
+  // one. The dummy value handed out by ObReferenceObjectByHandle needs no work.
+  if (native_ptr == 0xDEADF00D) {
+    return native_ptr;
+  }
+
+  auto object = XObject::GetNativeObject<XObject>(
+      REX_KERNEL_STATE(), REX_KERNEL_MEMORY()->TranslateVirtual(native_ptr));
+  if (object) {
+    object->RetainHandle();
+  }
+
+  return native_ptr;
+}
+
 u32 ObDereferenceObject_entry(u32 native_ptr) {
   REXKRNL_IMPORT_TRACE("ObDereferenceObject", "ptr={:#x}", (uint32_t)native_ptr);
   // Check if a dummy value from ObReferenceObjectByHandle.
@@ -262,7 +278,7 @@ REX_EXPORT_STUB(__imp__ObInsertObject);
