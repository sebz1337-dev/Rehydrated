index 4ce4f9b9..dd6c7d39 100644
--- a/include/rex/hook.h
+++ b/include/rex/hook.h
@@ -81,6 +81,15 @@
   REX_STUB_RETURN(name, retval)              \
   static rex::ppc::detail::PPCFuncRegistrar _ppc_reg_##name(#name, &name);
 
+// Silent no-op export: identical behavior to REX_EXPORT_STUB, minus the
+// warning. Used for console-only features that are unavailable offline.
+#define REX_EXPORT_NOOP(name)                       \
+  extern "C" REX_FUNC(name) {                       \
+    (void)ctx;                                      \
+    (void)base;                                     \
+  }                                                 \
+  static rex::ppc::detail::PPCFuncRegistrar _ppc_reg_##name(#name, &name);
+
